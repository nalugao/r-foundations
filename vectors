```R
# Acesso a elementos individuais
vetor <- c(10, 20, 30, 40, 50)
primeiro_elemento <- vetor[1]  # Retorna o primeiro elemento (10)
terceiro_elemento <- vetor[3]  # Retorna o terceiro elemento (30)

# Acesso a um intervalo de elementos
sub_vetor <- vetor[2:4]  # Retorna um sub-vetor contendo os elementos 20, 30 e 40
```

```R
# Operações numéricas em vetores
vetor1 <- c(1, 2, 3)
vetor2 <- c(4, 5, 6)

soma <- vetor1 + vetor2  # Soma elemento por elemento
produto <- vetor1 * vetor2  # Multiplicação elemento por elemento

# Operações lógicas em vetores
vetor_logico1 <- c(TRUE, FALSE, TRUE)
vetor_logico2 <- c(FALSE, TRUE, FALSE)

resultado <- vetor_logico1 & vetor_logico2  # Operação lógica AND
```

```R
vetor <- c(10, 20, 30, 40, 50)

# Comprimento do vetor
comprimento <- length(vetor)

# Valor mínimo e máximo
minimo <- min(vetor)
maximo <- max(vetor)

# Média e soma
media <- mean(vetor)
soma <- sum(vetor)
```

```R
# Adicionar elementos a um vetor
vetor <- c(1, 2, 3)
vetor <- c(vetor, 4)  # Adiciona o elemento 4 ao vetor

# Remover elementos de um vetor
vetor <- c(1, 2, 3, 4, 5)
vetor <- vetor[-3]  # Remove o terceiro elemento do vetor

# Modificar elementos em um vetor
vetor <- c(1, 2, 3)
vetor[2] <- 10  # Modifica o segundo elemento para 10
```